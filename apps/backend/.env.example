# Database configuration
DB_HOST= localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=passsword_postgres
DB_NAME=namedatabase

# Server 
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:5173
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false

# JWT_SECRET
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me

# Timezone and notification settings
NOTIFICATION_TIME_ZONE=Asia/Ho_Chi_Minh
NOTIFICATION_WORKOUT_REMINDER_DAILY_TIME=00:00

# OAuth2 configuration for Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# SMTP configuration
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-verified-sender@gmail.com

# API keys for third-party services
GROQ_API_KEY=your-groq-api-key

# Environment
NODE_ENV = production
ENABLE_RATE_LIMITER = true